# MongoDB Connection String (e.g. MongoDB Atlas or local replica set)
MONGODB_URI=mongodb://localhost:27017/bvtalent

# JWT and Admin Authentication Secret (min 32 characters)
AUTH_SECRET=bvtalent_super_secret_jwt_key_at_least_32_chars_long

# Cryptographic Pepper for Voter Code Hashing (HMAC secret)
VOTER_CODE_PEPPER=bvtalent_voter_code_secret_pepper_value_min_32_chars

# Public Application URL
APP_URL=http://localhost:3000

# Initial Admin Bootstrap Credentials (Used during initial setup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_password_immediately_123!
